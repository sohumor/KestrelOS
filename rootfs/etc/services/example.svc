# Template service file. Copy it, drop the enabled=no line and add
# `service <name>` to /etc/inittab. Every key is optional except exec=.
#
#   name=      informational; the unit name always follows the file name
#   exec=      absolute path of the program (required)
#   args=      arguments, split on whitespace, at most 8
#   respawn=   yes|no - restart it when it exits (default yes)
#   after=     start only once this other service has been started
#   stdout=    append the program's fd 1 to this file (default: console)
#   stderr=    only honoured when it equals stdout=; fd 2 stays on console
#   enabled=   yes|no - no means configured but not started (default yes)
name=example
exec=/bin/true
args=
respawn=no
after=logger
enabled=no
